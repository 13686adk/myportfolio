# EmailJS — https://dashboard.emailjs.com
# 1. Email Services  -> New Service  -> copy the Service ID
# 2. Email Templates -> New Template -> copy the Template ID
# 3. Account         -> copy the Public Key
#
# The template must define these variables:
#   {{from_name}}  {{reply_to}}  {{message}}  {{to_name}}
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Your deployed domain — used for canonical URLs, OG tags, sitemap and robots
NEXT_PUBLIC_SITE_URL=http://localhost:3000